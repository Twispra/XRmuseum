    "usage": "Load this JSON as d, provide original source path, then execute replay_python with source_path and output_path defined. It writes only the primary binary mask; compare SHA256 to mask_sha256.",
    "python": "import numpy as np\nfrom PIL import Image, ImageDraw\nfrom scipy import ndimage as ndi\np=d['parameters']; a=np.asarray(Image.open(source_path).convert('RGB')); h,w=a.shape[:2]\ndef poly(points):\n    im=Image.new('1',(w,h)); ImageDraw.Draw(im).polygon([tuple(v) for v in points],fill=1)\n    return np.asarray(im,dtype=bool)\nsupport=np.zeros((h,w),bool); excluded=support.copy()\nfor r in p['support_polygons']: support|=poly(r['points'])\nfor r in p['exclusion_polygons']: excluded|=poly(r['points'])\nrgb=a.astype(float)/255; mx=rgb.max(2); mn=rgb.min(2); delta=mx-mn\nsat=np.divide(delta,mx,out=np.zeros_like(mx),where=mx>0); hue=np.zeros_like(mx)\nr,g,b=rgb[:,:,0],rgb[:,:,1],rgb[:,:,2]\nrr=(mx==r)&(delta>0); gg=(mx==g)&~rr&(delta>0); bb=~rr&~gg&(delta>0)\nhue[rr]=np.mod((g[rr]-b[rr])/delta[rr],6)\nhue[gg]=(b[gg]-r[gg])/delta[gg]+2; hue[bb]=(r[bb]-g[bb])/delta[bb]+4; hue*=60\nt=p['primary_hsv']; candidate=(hue>=t['hue_min_deg'])&(hue<=t['hue_max_deg'])&(sat>=t['saturation_min'])&(mx>=t['value_min'])&support&~excluded\nfor r in p.get('surface_restore_polygons',[]): candidate|=poly(r['points'])&support&~excluded\nst=ndi.generate_binary_structure(2,2); lab,n=ndi.label(candidate,st); sizes=np.bincount(lab.ravel()); wanted=set()\nfor x,y in p['seed_points_px']:\n    if lab[y,x]>0: wanted.add(int(lab[y,x]))\n    else:\n        choices=np.unique(lab[max(0,y-8):min(h,y+9),max(0,x-8):min(w,x+9)]); choices=choices[choices>0]\n        if len(choices): wanted.add(int(max(choices,key=lambda z:sizes[z])))\nkeep=np.isin(lab,list(wanted))&np.isin(lab,np.flatnonzero(sizes>=p['minimum_seeded_component_area_px']))\nholes=ndi.binary_fill_holes(keep)&~keep; hl,n=ndi.label(holes,st); hs=np.bincount(hl.ravel())\nsmall=np.isin(hl,np.flatnonzero((hs<=p['small_hole_fill_max_px'])&(np.arange(len(hs))>0)))\nkeep=(keep|small)&support&~excluded\nImage.fromarray((keep*255).astype(np.uint8),'L').save(output_path)\n"
