  m_Name: Era-1839-Standard-Dress
  m_EditorClassIdentifier: 
  displayName: "1839 \u65E9\u671F\u5C01\u95ED\u5F0F\u5934\u76D4 \xB7 1881-47"
  sortOrder: 10
  summary: "\u4F9D\u636E\u82F1\u56FD\u79D1\u5B66\u535A\u7269\u9986\u96C6\u56E2\u9986\u85CF
    1881-47 \u7684\u7167\u7247\u5236\u4F5C\uFF1A\u5706\u9876\u5E3D\u4F53\u3001\u4E09\u5904\u5E26\u62A4\u680F\u89C2\u5BDF\u7A97\u4E0E\u5BBD\u5927\u7684\u80F8\u80A9\u677F\u3002\u4E0D\u53EF\u89C1\u7684\u80CC\u9762\u548C\u90E8\u4EF6\u5C3A\u5BF8\u662F\u5EFA\u6A21\u4F30\u7B97\u3002"
  servicePeriod: "1839 \u5E74\u5236\uFF08\u9986\u85CF\u5E74\u4EE3\uFF1B\u4F7F\u7528\u5E74\u9650\u672A\u8BE6\uFF09"
  operatingDepth: "\u8BE5\u9986\u85CF\u9875\u672A\u6CE8\u660E\u4F5C\u4E1A\u6DF1\u5EA6"
  factSource: "Science Museum Group Collection 1881-47: https://collection.sciencemuseumgroup.org.uk/objects/co40614/first-closed-diving-helmet-and-breastplate\uFF1B\u5916\u5F62\u53C2\u7167\u5176\u516C\u5F00\u7167\u7247\uFF0C\u4E0D\u590D\u5236\u7167\u7247\u3002\u9986\u85CF\u7ED9\u51FA\u6574\u4F53
    465\xD7460\xD7417 mm\uFF0C\u672A\u6807\u660E\u5404\u8F74\uFF0C\u6A21\u578B\u8F74\u5411\u53CA\u5C40\u90E8\u5C3A\u5BF8\u4E3A\u4F30\u7B97\u3002"
  shellMaterial: {fileID: 2100000, guid: 82e070bad9504784b952fd84a0d4e844, type: 2}
  windowMaterial: {fileID: 2100000, guid: b28de3dfbd9e6dd4db00d4f1ab86abd4, type: 2}
  fittingMaterial: {fileID: 2100000, guid: 333de6ecdcfcb6840b0e9097e5ae6bcf, type: 2}
  breastplateMaterial: {fileID: 0}
  fadeDuringSwap: 1
  details:
  - label: WINDOW
    text: "\u9986\u85CF\u7167\u7247\u53EF\u89C1\u4E09\u5904\u5E26\u62A4\u680F\u7684\u89C2\u5BDF\u7A97\uFF1B\u6E38\u620F\u5185\u524D\u9762\u677F\u7684\u5F00\u542F\u662F\u865A\u62DF\u5256\u6790\u529F\u80FD\uFF0C\u5E76\u975E\u6709\u53F2\u6599\u8BC1\u5B9E\u7684\u539F\u7269\u94F0\u94FE\u3002"
  - label: AIR
    text: "\u9986\u85CF\u8BB0\u5F55\u672A\u7ED9\u51FA\u6B64\u4EF6\u4F9B\u6C14\u63A5\u5934\u7684\u51C6\u786E\u4F4D\u7F6E\uFF1B\u573A\u666F
      AIR \u6807\u8BB0\u53EA\u662F\u6559\u5B66\u4EA4\u4E92\u951A\u70B9\u3002"
  - label: SHELL
    text: "\u5706\u9876\u5E3D\u4F53\u4E0E\u80F8\u80A9\u677F\u7684\u6574\u4F53\u8F6E\u5ED3\u53C2\u7167\u9986\u85CF\u7167\u7247\uFF1B\u80CC\u9762\u3001\u7D27\u56FA\u4EF6\u4F4D\u7F6E\u548C\u5404\u90E8\u4EF6\u5C3A\u5BF8\u5C5E\u4E8E\u5EFA\u6A21\u4F30\u7B97\u3002"
