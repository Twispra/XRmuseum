  m_Name: Era-1839-Standard-Dress
  m_EditorClassIdentifier: 
  displayName: "1839 \u6807\u51C6\u6F5C\u6C34\u670D\u5934\u76D4"
  sortOrder: 10
  summary: "\u6700\u65E9\u7684\u5B9E\u7528\u578B\u5C01\u95ED\u5934\u76D4\uFF0C\u9760\u8F6F\u7BA1\u4ECE\u6C34\u9762\u4F9B\u6C14\u3002\u8FD9\u4E00\u4EE3\u5960\u5B9A\u4E86\u300C\u575A\u786C\u58F3\u4F53\u52A0\u524D\u7F6E\u89C2\u5BDF\u7A97\u300D\u7684\u57FA\u672C\u5F62\u6001\u3002"
  servicePeriod: "1839 \u5E74\u8D77\uFF08\u65E9\u671F\u5546\u4E1A\u6F5C\u6C34\uFF09"
  operatingDepth: "\u7531\u6C34\u9762\u8F6F\u7BA1\u8FDE\u7EED\u4F9B\u6C14\uFF0C\u4F5C\u4E1A\u6DF1\u5EA6\u53D7\u9650"
  factSource: "\u56E2\u961F\u91C7\u7528\u7684\u516C\u5F00\u53F2\u6599\u53E3\u5F84\uFF0C\u4E0D\u662F\u672C\u7EC4\u6D4B\u91CF\uFF0C\u5177\u4F53\u5C3A\u5BF8\u4E0E\u5E74\u4EE3\u8FB9\u754C\u672A\u5728\u4ED3\u5E93\u4E2D\u9010\u9879\u6838\u5B9E\u3002"
  shellMaterial: {fileID: 2100000, guid: 82e070bad9504784b952fd84a0d4e844, type: 2}
  windowMaterial: {fileID: 2100000, guid: b28de3dfbd9e6dd4db00d4f1ab86abd4, type: 2}
  fittingMaterial: {fileID: 2100000, guid: 333de6ecdcfcb6840b0e9097e5ae6bcf, type: 2}
  breastplateMaterial: {fileID: 0}
  fadeDuringSwap: 1
  details:
  - label: WINDOW
    text: "\u5355\u9762\u5C0F\u578B\u524D\u7A97\uFF0C\u89C6\u91CE\u7A84\uFF0C\u73BB\u7483\u4EC5\u8986\u76D6\u6B63\u524D\u65B9\u3002"
  - label: AIR
    text: "\u8FDE\u7EED\u8F6F\u7BA1\u9001\u6C14\uFF0C\u6F5C\u6C34\u5458\u4E0D\u643A\u5E26\u81EA\u4E3B\u6C14\u6E90\u3002"
  - label: SHELL
    text: "\u94DC\u5236\u7403\u58F3\u4E0E\u8F6F\u8D28\u6F5C\u6C34\u670D\u7F1D\u5408\uFF0C\u9888\u90E8\u7528\u87BA\u6813\u538B\u7D27\u3002"
