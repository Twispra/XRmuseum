    traditionalChinese: "\u4F9B\u6C23\uFF1A\u5C1A\u672A\u67E5\u770B\n\u901A\u8A71\uFF1A\u5DF2\u67E5\u770B\uFF0C\u4FE1\u606F\u96D9\u5411\u50B3\u905E\u3002"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.d37da505faee
    chinese: "\u4F9B\u6C14\uFF1A\u5DF2\u67E5\u770B\uFF0C\u7A7A\u6C14\u6765\u81EA\u6C34\u9762\u3002\n\u901A\u8BDD\uFF1A\u5C1A\u672A\u67E5\u770B"
    english: 'Air: seen - air arrives from the surface.

      Voice: not seen yet'
    traditionalChinese: "\u4F9B\u6C23\uFF1A\u5DF2\u67E5\u770B\uFF0C\u7A7A\u6C23\u4F86\u81EA\u6C34\u9762\u3002\n\u901A\u8A71\uFF1A\u5C1A\u672A\u67E5\u770B"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.42fe3f276382
    chinese: "\u4F9B\u6C14\uFF1A\u5DF2\u67E5\u770B\uFF0C\u7A7A\u6C14\u6765\u81EA\u6C34\u9762\u3002\n\u901A\u8BDD\uFF1A\u5DF2\u67E5\u770B\uFF0C\u4FE1\u606F\u53CC\u5411\u4F20\u9012\u3002"
    english: 'Air: seen - air arrives from the surface.

      Voice: seen - messages
      travel both ways.'
    traditionalChinese: "\u4F9B\u6C23\uFF1A\u5DF2\u67E5\u770B\uFF0C\u7A7A\u6C23\u4F86\u81EA\u6C34\u9762\u3002\n\u901A\u8A71\uFF1A\u5DF2\u67E5\u770B\uFF0C\u4FE1\u606F\u96D9\u5411\u50B3\u905E\u3002"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.df3412a623d6
    chinese: "\u5DF2\u60AC\u505C / \u5256\u9762\u5DF2\u5F00\u542F\n\u8C03\u6574\u5256\u9762\uFF1A\u63E1\u4F4F\u9752\u8272\u7403\u67C4\uFF0C\u79FB\u52A8\u5E76\u8F6C\u52A8"
    english: 'FLOATING  /  SECTION ON

      EDIT CUT: grip the cyan handle, move
      + twist'
    traditionalChinese: "\u5DF2\u61F8\u505C / \u5256\u9762\u5DF2\u958B\u5553\n\u8ABF\u6574\u5256\u9762\uFF1A\u63E1\u4F4F\u9752\u8272\u7403\u67C4\uFF0C\u79FB\u52D5\u4E26\u8F49\u52D5"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.98a9e457b6e9
    chinese: "\u5256\u9762\u5DF2\u5F00\u542F\n\u8C03\u6574\u5256\u9762\uFF1A\u63E1\u4F4F\u9752\u8272\u7403\u67C4\uFF0C\u79FB\u52A8\u5E76\u8F6C\u52A8"
    english: 'SECTION ON

      EDIT CUT: grip the cyan handle, move + twist'
    traditionalChinese: "\u5256\u9762\u5DF2\u958B\u5553\n\u8ABF\u6574\u5256\u9762\uFF1A\u63E1\u4F4F\u9752\u8272\u7403\u67C4\uFF0C\u79FB\u52D5\u4E26\u8F49\u52D5"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.7c605a408f85
    chinese: "\u6309\u63E1\u6301\u952E\u9009\u62E9 / \u5355\u624B\u64CD\u4F5C\n\u60AC\u505C\uFF1A\u62FF\u8D77\u5E76\u8F6C\u52A8\uFF0C\u677E\u624B\u540E\u4FDD\u6301\u59FF\u6001"
    english: 'GRIP TO SELECT  /  ONE HAND

      FLOAT: pick up, turn freely, release
      to keep pose'
    traditionalChinese: "\u6309\u63E1\u6301\u9375\u9078\u64C7 / \u55AE\u624B\u64CD\u4F5C\n\u61F8\u505C\uFF1A\u62FF\u8D77\u4E26\u8F49\u52D5\uFF0C\u9B06\u624B\u5F8C\u4FDD\u6301\u59FF\u614B"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.03bb9dba3f02
    chinese: "\u6234\u4E0A\u8FD9\u9876\u5934\u76D4\uFF0C\u5C31\u80FD\u72EC\u81EA\u5728\u6C34\u4E0B\u5DE5\u4F5C\u4E86\u5417\uFF1F\n\u8F6C\u52A8\u770B\u770B\uFF0C\u53EF\u4EFB\u610F\u9009\u62E9\u201C\u4F9B\u6C14\u201D\u6216\u201C\u901A\u8BDD\u201D\u3002"
    english: 'Could a diver work alone in this helmet?

      Look around it. Choose
      AIR or VOICE in any order.'
    traditionalChinese: "\u6234\u4E0A\u9019\u9802\u982D\u76D4\uFF0C\u5C31\u80FD\u7368\u81EA\u5728\u6C34\u4E0B\u5DE5\u4F5C\u4E86\u55CE\uFF1F\n\u8F49\u52D5\u770B\u770B\uFF0C\u53EF\u4EFB\u610F\u9078\u64C7\u201C\u4F9B\u6C23\u201D\u6216\u201C\u901A\u8A71\u201D\u3002"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.0f8f053e4cf8
    chinese: "\u4F9B\u6C14\u63A5\u5934\n\u6309\u63E1\u6301\u952E\u63A2\u7D22"
    english: 'AIR CONNECTOR

      Grip to explore'
    traditionalChinese: "\u4F9B\u6C23\u63A5\u982D\n\u6309\u63E1\u6301\u9375\u63A2\u7D22"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.8131aca398c4
    chinese: "\u6F5C\u6C34\u5934\u76D4\n<size=62%>\u53C2\u8003 Mark V \u7684\u7814\u7A76\u6A21\u578B</size>"
    english: 'Diving helmet

      <size=62%>Mark V-inspired study</size>'
    traditionalChinese: "\u6F5B\u6C34\u982D\u76D4\n<size=62%>\u53C3\u8003 Mark V
      \u7684\u7814\u7A76\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.7ffcdd12f7e9
    chinese: "\u4F9B\u6C14\u6CF5 \u2192 \u5934\u76D4 / \u9759\u6001\u5C55\u793A\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Pump > helmet / static view

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u4F9B\u6C23\u6CF5 \u2192 \u982D\u76D4 / \u975C\u614B\u5C55\u793A\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.fbefc6875cd4
    chinese: "\u53CC\u5411\u901A\u8BDD / \u9759\u6001\u5C55\u793A\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Two-way voice / static view

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u96D9\u5411\u901A\u8A71 / \u975C\u614B\u5C55\u793A\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.8cfcc776230f
    chinese: "\u4F9B\u6C14\u6CF5\u4E0E\u8F6F\u7BA1\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Pump and hose

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u4F9B\u6C23\u6CF5\u8207\u8EDF\u7BA1\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.3e27127af61a
    chinese: "\u4F9B\u6C14\uFF1A\u6CF5 \u2192 \u5934\u76D4\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Air: pump > helmet

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u4F9B\u6C23\uFF1A\u6CF5 \u2192 \u982D\u76D4\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.cf67f9fd6d9c
    chinese: "\u7A7A\u6C14\u7531\u6C34\u9762\u4F9B\u5E94\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Air supplied from the surface

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u7A7A\u6C23\u7531\u6C34\u9762\u4F9B\u61C9\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.e8005f33fbb1
    chinese: "\u6C34\u9762\u7AEF\u4E0E\u6F5C\u6C34\u5458\u7AEF\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Surface and diver

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u6C34\u9762\u7AEF\u8207\u6F5B\u6C34\u54E1\u7AEF\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.21f0cb9529f4
    chinese: "\u53D1\u8BDD\uFF1A\u6C34\u9762 \u2192 \u6F5C\u6C34\u5458\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Message: surface > diver

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u767C\u8A71\uFF1A\u6C34\u9762 \u2192 \u6F5B\u6C34\u54E1\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.65a093c4dc86
    chinese: "\u7B49\u5F85\u56DE\u590D\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Waiting for a reply

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u7B49\u5F85\u56DE\u8986\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.78232cecdca4
    chinese: "\u56DE\u590D\uFF1A\u6F5C\u6C34\u5458 \u2192 \u6C34\u9762\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'Reply: diver > surface

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u56DE\u8986\uFF1A\u6F5B\u6C34\u54E1 \u2192 \u6C34\u9762\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.b8b017494414
    chinese: "\u53CC\u5411\u901A\u8BDD\u8FDE\u63A5\n<size=75%>\u6559\u5B66\u793A\u610F\u6A21\u578B</size>"
    english: 'A two-way connection

      <size=75%>Illustrative model</size>'
    traditionalChinese: "\u96D9\u5411\u901A\u8A71\u9023\u63A5\n<size=75%>\u6559\u5B78\u793A\u610F\u6A21\u578B</size>"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.9937e365aaf3
    chinese: "\u7B80\u4F53\u4E2D\u6587"
    english: "\u7B80\u4F53\u4E2D\u6587"
    traditionalChinese: "\u7B80\u4F53\u4E2D\u6587"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: text.1c95ab9b144e
    chinese: "\u7E41\u9AD4\u4E2D\u6587"
    english: "\u7E41\u9AD4\u4E2D\u6587"
    traditionalChinese: "\u7E41\u9AD4\u4E2D\u6587"
    note: Visitor-facing exhibit copy; translated from existing English.
  - key: hotspots.prompt
    chinese: "\u9009\u62E9\u4E00\u4E2A\u9AD8\u4EAE\u6807\u8BB0\uFF0C\u89C2\u5BDF\u5934\u76D4\u3002"
    english: Select a highlighted point to inspect the helmet.
    traditionalChinese: "\u9078\u64C7\u4E00\u500B\u9AD8\u4EAE\u6A19\u8A18\uFF0C\u89C0\u5BDF\u982D\u76D4\u3002"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: hotspots.front_window
    chinese: "\u524D\u7A97\n\u89C2\u5BDF\u524D\u65B9\u89C6\u7A97\u53CA\u5468\u56F4\u7684\u8FB9\u6846\u3002"
    english: 'Front window

      Inspect the front viewing area and its surrounding
      rim.'
    traditionalChinese: "\u524D\u7A97\n\u89C0\u5BDF\u524D\u65B9\u8996\u7A97\u53CA\u5468\u570D\u7684\u908A\u6846\u3002"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: hotspots.bonnet
    chinese: "\u4E0A\u90E8\u5916\u58F3\n\u89C2\u5BDF\u5706\u5F62\u7684\u4E0A\u90E8\u5916\u58F3\u548C\u6574\u4F53\u5F62\u72B6\u3002"
    english: 'Bonnet shell

      Inspect the rounded upper shell and its overall
      form.'
    traditionalChinese: "\u4E0A\u90E8\u5916\u6BBC\n\u89C0\u5BDF\u5713\u5F62\u7684\u4E0A\u90E8\u5916\u6BBC\u548C\u6574\u9AD4\u5F62\u72C0\u3002"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: hotspots.breastplate
    chinese: "\u80F8\u7532\n\u89C2\u5BDF\u80A9\u90E8\u5468\u56F4\u5BBD\u5927\u7684\u4E0B\u90E8\u7ED3\u6784\u3002"
    english: 'Breastplate

      Inspect the broad lower section around the shoulders.'
    traditionalChinese: "\u80F8\u7532\n\u89C0\u5BDF\u80A9\u90E8\u5468\u570D\u5BEC\u5927\u7684\u4E0B\u90E8\u7D50\u69CB\u3002"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: hotspots.progress.0
    chinese: "\u5DF2\u89C2\u5BDF 0 / 3 \u4E2A\u90E8\u4F4D"
    english: 0 / 3 inspected
    traditionalChinese: "\u5DF2\u89C0\u5BDF 0 / 3 \u500B\u90E8\u4F4D"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: hotspots.progress.1
    chinese: "\u5DF2\u89C2\u5BDF 1 / 3 \u4E2A\u90E8\u4F4D"
    english: 1 / 3 inspected
    traditionalChinese: "\u5DF2\u89C0\u5BDF 1 / 3 \u500B\u90E8\u4F4D"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: hotspots.progress.2
    chinese: "\u5DF2\u89C2\u5BDF 2 / 3 \u4E2A\u90E8\u4F4D"
    english: 2 / 3 inspected
    traditionalChinese: "\u5DF2\u89C0\u5BDF 2 / 3 \u500B\u90E8\u4F4D"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: hotspots.progress.3
    chinese: "\u5DF2\u89C2\u5BDF 3 / 3 \u4E2A\u90E8\u4F4D"
    english: 3 / 3 inspected
    traditionalChinese: "\u5DF2\u89C0\u5BDF 3 / 3 \u500B\u90E8\u4F4D"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: hotspots.complete
    chinese: "\u90E8\u4F4D\u63A2\u7D22\u5B8C\u6210"
    english: Exploration complete
    traditionalChinese: "\u90E8\u4F4D\u63A2\u7D22\u5B8C\u6210"
    note: Helmet hotspot inspection copy; translated from existing English.
  - key: experience.sound.on
    chinese: "\u58F0\u97F3\uFF1A\u5F00"
    english: 'Sound: on'
    traditionalChinese: "\u8072\u97F3\uFF1A\u958B"
    note: Optional synthesized mechanical feedback; not a historical recording.
  - key: experience.sound.off
    chinese: "\u58F0\u97F3\uFF1A\u5173"
    english: 'Sound: off'
    traditionalChinese: "\u8072\u97F3\uFF1A\u95DC"
    note: Optional synthesized mechanical feedback; not a historical recording.
  - key: experience.telephone.connection
    chinese: "\u901A\u8BDD\u63A5\u5934"
    english: Telephone connection
    traditionalChinese: "\u901A\u8A71\u63A5\u982D"
    note: Saved rear telephone fitting; position is illustrative, not an engineering
      measurement.
  - key: refined.superlite.instructions
    chinese: "\u6F5C\u6C34\u5934\u76D4\n<size=62%>\u53C2\u8003 SuperLite 17B \u7684\u6A21\u578B</size>"
    english: 'Diving helmet

      <size=62%>SuperLite 17B-inspired study</size>'
    traditionalChinese: "\u6F5B\u6C34\u982D\u76D4\n<size=62%>\u53C3\u8003 SuperLite
      17B \u7684\u6A21\u578B</size>"
    note: Visitor title follows the applied SuperLite visual; an inspired study,
      not a measured reconstruction.
  - key: refined.superlite.hotspots.front_window
    chinese: "\u524D\u7A97\n\u89C2\u5BDF\u524D\u7A97\u548C\u8FB9\u6846\u3002\u4FA7\u5F00\u4EC5\u7528\u4E8E\u5C55\u5385\u6F14\u793A\uFF0C\u4E0D\u4EE3\u8868\u5B9E\u7269\u7ED3\u6784\u3002"
    english: 'Front window

      Window and rim. Side opening is a museum demonstration.'
    traditionalChinese: "\u524D\u7A97\n\u89C0\u5BDF\u524D\u7A97\u548C\u908A\u6846\u3002\u5074\u958B\u50C5\u7528\u65BC\u5C55\u5EF3\u6F14\u793A\uFF0C\u4E0D\u4EE3\u8868\u5BE6\u7269\u7D50\u69CB\u3002"
    note: The marker follows the moving glass. The side-opening motion is a teaching
      demonstration.
  - key: refined.superlite.hotspots.shell
    chinese: "\u5934\u76D4\u5916\u58F3\n\u89C2\u5BDF\u8FD9\u6B3E\u8F7B\u578B\u5934\u76D4\u6A21\u578B\u7684\u4E0A\u90E8\u5916\u58F3\u3002"
    english: 'Helmet shell

      Inspect the upper shell of this lightweight helmet
      study.'
    traditionalChinese: "\u982D\u76D4\u5916\u6BBC\n\u89C0\u5BDF\u9019\u6B3E\u8F15\u578B\u982D\u76D4\u6A21\u578B\u7684\u4E0A\u90E8\u5916\u6BBC\u3002"
    note: SuperLite shell hotspot; discovery identity is shared across visual eras.
  - key: refined.superlite.hotspots.neck
    chinese: "\u9888\u90E8\u5BC6\u5C01\n\u89C2\u5BDF\u5916\u58F3\u4E0B\u65B9\u7684\u9888\u90E8\u5BC6\u5C01\u548C\u5468\u56F4\u7684\u5939\u73AF\u3002"
    english: 'Neck seal

      Inspect the neck seal and surrounding clamp below
      the shell.'
    traditionalChinese: "\u9838\u90E8\u5BC6\u5C01\n\u89C0\u5BDF\u5916\u6BBC\u4E0B\u65B9\u7684\u9838\u90E8\u5BC6\u5C01\u548C\u5468\u570D\u7684\u593E\u74B0\u3002"
    note: SuperLite neck seal hotspot, replacing the Mark V breastplate copy for
      this era.
  - key: refined.superlite.communication_location
    chinese: "\u901A\u4FE1\u4F4D\u7F6E\uFF08\u793A\u610F\uFF09"
    english: Communication location (illustrative)
    traditionalChinese: "\u901A\u4FE1\u4F4D\u7F6E\uFF08\u793A\u610F\uFF09"
    note: The model has no confirmed telephone posts. This endpoint is a teaching
      position; no mechanical fitting is identified as a telephone part.
  - key: inspection.status.select.vr
    chinese: "\u6307\u5411\u540E\u6309\u63E1\u628A\u952E\u9009\u62E9"
    english: Point + grip to select
    traditionalChinese: "\u6307\u5411\u5F8C\u6309\u63E1\u628A\u9375\u9078\u64C7"
    note: Visitor instruction for physical VR controllers; Unity Editor keeps its
      keyboard simulator hint.
  - key: inspection.help.vr
    chinese: "\u6307\u5411\u6309\u94AE\u5E76\u6309\u63E1\u628A\u952E\uFF1A\u9009\u62E9\u3002\n\u6309\u4F4F\u63E1\u628A\u952E\uFF1A\u6293\u53D6\u5934\u76D4\u3002\n\u677E\u5F00\u63E1\u628A\u952E\uFF1A\u653E\u4E0B\u5934\u76D4\u3002\n\u89C2\u5BDF\u9875
      Reset\uFF1A\u5934\u76D4\u590D\u4F4D\u3002\n\u91CD\u7F6E\u89C6\u89D2\uFF1A\u56DE\u5230\u8D77\u70B9\u3002"
    english: 'Point + grip: select a button.

      Hold grip: grab the helmet.

      Release
      grip: put it down.

      Inspect Reset: reset the helmet.

      Reset View:
      return to start.'
    traditionalChinese: "\u6307\u5411\u6309\u9215\u4E26\u6309\u63E1\u628A\u9375\uFF1A\u9078\u64C7\u3002\n\u6309\u4F4F\u63E1\u628A\u9375\uFF1A\u6293\u53D6\u982D\u76D4\u3002\n\u9B06\u958B\u63E1\u628A\u9375\uFF1A\u653E\u4E0B\u982D\u76D4\u3002\n\u89C0\u5BDF\u9801
      Reset\uFF1A\u982D\u76D4\u5FA9\u4F4D\u3002\n\u91CD\u8A2D\u8996\u89D2\uFF1A\u56DE\u5230\u8D77\u9EDE\u3002"
    note: Visitor Help in a VR player build; no Unity Editor keyboard shortcuts.
