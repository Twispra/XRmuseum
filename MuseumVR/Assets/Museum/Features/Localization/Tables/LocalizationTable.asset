  - key: text.0faf9ce6e87b
    chinese: "\u4ECE\u5934\u76D4\u5F00\u59CB\uFF0C\n\u79FB\u8FD1\u3001\u8F6C\u52A8\uFF0C\u518D\u770B\u770B\u5185\u90E8\u3002"
