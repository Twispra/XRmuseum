  - key: text.6f3f70818f2f
    chinese: "\u505C\u4E00\u505C\uFF0C\u518D\u770B\u770B\uFF0C\n\u8DDF\u968F\u81EA\u5DF1\u7684\u597D\u5947\u5FC3\u3002"
    english: 'Pause. Look again.

      Follow your curiosity.'
    traditionalChinese: "\u505C\u4E00\u505C\uFF0C\u518D\u770B\u770B\uFF0C\n\u8DDF\u96A8\u81EA\u5DF1\u7684\u597D\u5947\u5FC3\u3002"
